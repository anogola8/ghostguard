# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://ghostguard:ghostguard@localhost:5432/ghostguard

# Audit log HMAC key — MUST live outside the DB.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Losing this key invalidates all existing chains. Rotate only via a documented migration.
GHOSTGUARD_AUDIT_HMAC_KEY=change-me-48-bytes-of-random

# ID reference hashing (PBKDF2 iterations — raise as hardware improves)
GHOSTGUARD_ID_PBKDF2_ITERATIONS=390000

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1